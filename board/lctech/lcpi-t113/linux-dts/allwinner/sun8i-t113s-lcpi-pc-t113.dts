// LC Technology LCPI-PC-T113 mainline bring-up

/dts-v1/;

#include "sun8i-t113s.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "LC Technology LCPI-PC-T113";
	compatible = "lctech,lcpi-pc-t113", "allwinner,sun8i-t113s";

	aliases {
		serial3 = &uart3;
	};

	chosen {
		stdout-path = "serial3:115200n8";
	};

	reg_vcc5v: regulator-5v {
		compatible = "regulator-fixed";
		regulator-name = "vcc-5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
		regulator-boot-on;
	};

	reg_3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&reg_vcc5v>;
		regulator-always-on;
		regulator-boot-on;
	};

	reg_core: regulator-core {
		compatible = "regulator-fixed";
		regulator-name = "vcc-core";
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
		vin-supply = <&reg_vcc5v>;
		regulator-always-on;
		regulator-boot-on;
	};

	reg_avdd2v8: regulator-avdd2v8 {
		compatible = "regulator-fixed";
		regulator-name = "avdd2v8";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		vin-supply = <&reg_3v3>;
		regulator-always-on;
		regulator-boot-on;
	};

	panel_rgb: panel {
		/* EYA EP4303B-V1: ST7282, 4.3 inch RGB-TTL panel. */
		compatible = "lctech,ep4303b-v1", "panel-dpi";
		power-supply = <&reg_3v3>;
		width-mm = <95>;
		height-mm = <54>;

		panel-timing {
			/* EP4303B-DCT data sheet, typical 9 MHz timing. */
			clock-frequency = <9000000>;
			hactive = <480>;
			hfront-porch = <8>;
			hback-porch = <39>;
			hsync-len = <4>;
			vactive = <272>;
			vfront-porch = <8>;
			vback-porch = <8>;
			vsync-len = <4>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
			/* Panel samples data on DCLK falling edge. */
			pixelclk-active = <1>;
		};

		port {
			panel_rgb_in: endpoint {
				remote-endpoint = <&tcon_lcd0_out_rgb>;
			};
		};
	};
};

&cpu0 {
	cpu-supply = <&reg_core>;
};

&cpu1 {
	cpu-supply = <&reg_core>;
};

&dcxo {
	clock-frequency = <24000000>;
};

&de {
	status = "okay";
};

&lcd_rgb666_pins {
	drive-strength = <30>;
	bias-disable;
};

&mmc0 {
	pinctrl-0 = <&mmc0_pins>;
	pinctrl-names = "default";
	vmmc-supply = <&reg_3v3>;
	cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>;
	disable-wp;
	bus-width = <4>;
	status = "okay";
};

&mmc0_pins {
	drive-strength = <30>;
	bias-pull-up;
};

&pio {
	vcc-pb-supply = <&reg_3v3>;
	vcc-pc-supply = <&reg_3v3>;
	vcc-pd-supply = <&reg_3v3>;
	vcc-pe-supply = <&reg_avdd2v8>;
	vcc-pf-supply = <&reg_3v3>;
	vcc-pg-supply = <&reg_3v3>;

	i2c2_pe_pins: i2c2-pe-pins {
		pins = "PE12", "PE13";
		function = "i2c2";
		drive-strength = <10>;
		bias-disable;
	};
};

/*
 * EP4303B-DCT's GT911 is on the dedicated CTP FPC connector (P4).
 * P4 uses PB2/PB3 for reset/interrupt and PE12/PE13 for I2C2.
 */
&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pe_pins>;
	clock-frequency = <100000>;
	status = "okay";

	touchscreen@14 {
		compatible = "goodix,gt911";
		reg = <0x14>;
		interrupt-parent = <&pio>;
		interrupts = <1 3 IRQ_TYPE_EDGE_FALLING>;
		irq-gpios = <&pio 1 3 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pio 1 2 GPIO_ACTIVE_HIGH>;
		AVDD28-supply = <&reg_3v3>;
		VDDIO-supply = <&reg_3v3>;
		touchscreen-size-x = <480>;
		touchscreen-size-y = <272>;
		status = "okay";
	};
};

&tcon_lcd0 {
	pinctrl-names = "default";
	pinctrl-0 = <&lcd_rgb666_pins>;
	status = "okay";

	ports {
		port@1 {
			tcon_lcd0_out_rgb: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&panel_rgb_in>;
			};
		};
	};
};

&tcon_top {
	status = "okay";
};

&uart0 {
	status = "disabled";
};

&uart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart3_pb_pins>;
	status = "okay";
};

/* USB0 is the Type-C device port; USB1 is the host port. */
&usb_otg {
	dr_mode = "peripheral";
	status = "okay";
};

&usbphy {
	usb1_vbus-supply = <&reg_vcc5v>;
	status = "okay";
};

&ehci1 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};
