BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_LCPI_T113_PATH)/board/lctech/lcpi-t113/rootfs_overlay"
BR2_ROOTFS_POST_IMAGE_SCRIPT="support/scripts/genimage.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="-c $(BR2_EXTERNAL_LCPI_T113_PATH)/board/lctech/lcpi-t113/genimage.cfg"
